<UserControl x:Class="Embistic.Controls.ImmersivePlayerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Embistic.Controls"
 Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
 FontFamily="Segoe UI, Microsoft YaHei UI" ClipToBounds="True"
 AutomationProperties.Name="沉浸音乐播放器">
 <UserControl.Resources>
  <Style x:Key="GlassButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Background" Value="{DynamicResource Raised}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Glass" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glass" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Glass" Property="Opacity" Value=".5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Glass" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Margin" Value="0,3"/>
   <Setter Property="Background" Value="Transparent"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity=".25" Margin="-80" IsHitTestVisible="False">
   <Image.Effect><BlurEffect Radius="48" RenderingBias="Performance"/></Image.Effect>
  </Image>
  <Rectangle IsHitTestVisible="False"><Rectangle.Fill><SolidColorBrush x:Name="AlbumTint" Color="#244E6889"/></Rectangle.Fill></Rectangle>
  <Rectangle Fill="{DynamicResource Bg}" Opacity=".5" IsHitTestVisible="False"/>
  <Rectangle IsHitTestVisible="False" Opacity=".24">
   <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#00243954" Offset=".48"/><GradientStop Color="#80243954" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
  </Rectangle>
  <Grid Margin="25,18,25,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="BackButton" Style="{StaticResource GlassButton}" Click="Back_Click" AutomationProperties.Name="退出沉浸歌词" ToolTip="返回音乐库">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons" Margin="0,0,9,0"/><TextBlock Text="返回"/></StackPanel>
     </Button>
     <Button x:Name="FullscreenButton" Style="{StaticResource GlassButton}" Click="Fullscreen_Click" Margin="8,0,0,0" AutomationProperties.Name="切换全屏" ToolTip="切换全屏">
      <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
     </Button>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="EMBISTIC  /  NOW PLAYING" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".7"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <Button x:Name="SpectrumButton" Style="{StaticResource GlassButton}" Click="SpectrumSettings_Click" AutomationProperties.Name="频谱样式" Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="频谱样式"/></StackPanel>
     </Button>
     <Button x:Name="OptionsButton" Style="{StaticResource GlassButton}" Click="Options_Click" AutomationProperties.Name="歌词选项">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="歌词选项"/><TextBlock Text="⌄" Margin="8,0,0,0"/></StackPanel>
     </Button>
    </StackPanel>
    <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8" Width="222" Margin="0,8,0,0">
      <StackPanel><Button Content="歌词样式与动效" Click="LyricsSettings_Click" Style="{StaticResource OptionButton}"/><Button Content="导入本地 LRC" Click="ImportLyrics_Click" Style="{StaticResource OptionButton}"/><Button Content="显示 / 隐藏桌面歌词" Click="DesktopLyrics_Click" Style="{StaticResource OptionButton}"/></StackPanel>
     </Border>
    </Popup>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.41*"/><ColumnDefinition Width="0.59*"/></Grid.ColumnDefinitions>
    <Grid x:Name="RecordColumn" Margin="10,8,18,12">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Viewbox Stretch="Uniform" MaxWidth="480" MaxHeight="480" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Canvas Width="480" Height="480">
       <Grid x:Name="DiscRotor" Width="430" Height="430" Canvas.Left="15" Canvas.Top="38" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><RotateTransform x:Name="DiscRotation"/></Grid.RenderTransform>
        <Grid.CacheMode><BitmapCache RenderAtScale="1.25"/></Grid.CacheMode>
        <Grid.Effect><DropShadowEffect BlurRadius="24" Color="#000000" Opacity=".42" ShadowDepth="5"/></Grid.Effect>
        <Ellipse Stroke="#3B4249" StrokeThickness="1">
         <Ellipse.Fill><RadialGradientBrush RadiusX=".65" RadiusY=".65" Center=".4,.34" GradientOrigin=".34,.26"><GradientStop Color="#202329"/><GradientStop Color="#101317" Offset=".62"/><GradientStop Color="#070A0D" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Canvas x:Name="Grooves" Width="430" Height="430" IsHitTestVisible="False"/>
        <Ellipse Margin="1" IsHitTestVisible="False" Opacity=".18">
         <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#D8FFFFFF" Offset=".17"/><GradientStop Color="#00FFFFFF" Offset=".28"/><GradientStop Color="#00FFFFFF" Offset=".62"/><GradientStop Color="#78FFFFFF" Offset=".75"/><GradientStop Color="#00FFFFFF" Offset=".84"/></LinearGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="238" Height="238" Fill="#25364B" Stroke="#424B58" StrokeThickness="1"/>
        <TextBlock x:Name="RecordPlaceholder" Text="♪" FontSize="74" Foreground="#869DBB" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Ellipse Width="238" Height="238"><Ellipse.Fill><ImageBrush x:Name="RecordLabelImage" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
        <Ellipse Width="24" Height="24" Fill="#11151A" Stroke="#5A626C" StrokeThickness="1"/>
        <Ellipse Width="7" Height="7" Fill="#77828F"/>
       </Grid>
       <Canvas Width="480" Height="480" IsHitTestVisible="False">
        <Canvas.RenderTransform><RotateTransform x:Name="NeedleRotation" CenterX="382" CenterY="40" Angle="-13"/></Canvas.RenderTransform>
        <Ellipse Width="34" Height="34" Canvas.Left="365" Canvas.Top="23" Fill="#65778F" Opacity=".45"/>
        <Ellipse Width="23" Height="23" Canvas.Left="370.5" Canvas.Top="28.5" Fill="#DEE5EE" Stroke="#B8C2D0" StrokeThickness="1"/>
        <Ellipse Width="9" Height="9" Canvas.Left="377.5" Canvas.Top="35.5" Fill="#8FA0B6"/>
        <Path Data="M 382,43 C 383,112 357,150 329,189 L 313,208" Stroke="#D3DDE9" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
         <Path.Effect><DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity=".35"/></Path.Effect>
        </Path>
        <Rectangle Width="33" Height="12" Canvas.Left="302" Canvas.Top="198" RadiusX="2" RadiusY="2" Fill="#EDF3FA" Stroke="#9EAFC4" StrokeThickness="1" RenderTransformOrigin=".5,.5"><Rectangle.RenderTransform><RotateTransform Angle="-49"/></Rectangle.RenderTransform></Rectangle>
       </Canvas>
      </Canvas>
     </Viewbox>
     <StackPanel Grid.Row="1" Margin="14,6,14,12" HorizontalAlignment="Stretch">
      <TextBlock x:Name="TrackTitle" Text="今天，想听点什么？" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxHeight="65" TextAlignment="Center" ToolTip="当前歌曲"/>
      <TextBlock x:Name="TrackArtist" Text="从你的音乐库开始" Foreground="{DynamicResource SecondaryText}" FontSize="14" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,9,0,0"/>
      <TextBlock x:Name="TrackQuality" Text="EMBY MUSIC" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Center" Margin="0,13,0,0"/>
     </StackPanel>
    </Grid>
    <Border Grid.Column="1" Margin="0,0,6,0" Background="Transparent"><controls:AnimatedLyricsView x:Name="ImmersiveLyrics"/></Border>
   </Grid>
   <Grid x:Name="SpectrumSection" Grid.Row="2" Margin="0,0,0,0" ClipToBounds="True">
    <controls:SpectrumView x:Name="ImmersiveSpectrum" Height="90" HorizontalAlignment="Stretch"/>
    <Border x:Name="SpectrumStatusSurface" Background="{DynamicResource Panel}" CornerRadius="10" Padding="12,7" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,13" Visibility="Collapsed" Opacity=".85">
     <TextBlock x:Name="SpectrumStatusText" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Center" MaxWidth="720" TextWrapping="Wrap"/>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
