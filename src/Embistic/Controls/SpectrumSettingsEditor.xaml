<UserControl x:Class="Embistic.Controls.SpectrumSettingsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Text}" FontSize="12">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/SettingsEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TabControl><TabItem Header="形态与位置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="GeneralFields" Margin="0,0,10,0"/></ScrollViewer></TabItem><TabItem Header="配色与细节"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="StyleFields" Margin="0,0,10,0"/></ScrollViewer></TabItem></TabControl><DockPanel Grid.Row="1" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="恢复默认" Click="Reset_Click" Padding="8" FontSize="11"/><TextBlock x:Name="ValidationText" Text="修改即时生效并自动保存" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel></Grid></UserControl>
