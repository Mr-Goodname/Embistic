<UserControl x:Class="Embistic.Controls.LyricAppearanceEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Embistic.Controls" Foreground="{DynamicResource Text}" FontSize="12" AutomationProperties.Name="歌词外观和来源设置">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/SettingsEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Grid x:Name="EditorRoot"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TabControl x:Name="SettingsTabs" AutomationProperties.Name="歌词设置分类">
                <TabItem Header="字体" AutomationProperties.Name="字体设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="字体与回退" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="FontFamilyCombo" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="歌词字体和字体回退"/>
                                <TextBlock Text="可以选择本机字体，也可以用英文逗号输入多个字体，按顺序回退。" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="主播放器歌词" Style="{StaticResource SectionTitle}"/>
                                <Grid><TextBlock Text="字号" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=MainSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="MainSizeSlider" Minimum="14" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="False" Value="{Binding MainFontSize, Mode=TwoWay}" AutomationProperties.Name="主播放器歌词字号"/>
                                <TextBlock Text="字重" Style="{StaticResource FieldLabel}" Margin="0,13,0,7"/>
                                <ComboBox x:Name="MainWeightCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MainFontWeight, Mode=TwoWay}" AutomationProperties.Name="主播放器歌词字重"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="桌面歌词" Style="{StaticResource SectionTitle}"/>
                                <Grid><TextBlock Text="字号" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=DesktopSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="DesktopSizeSlider" Minimum="16" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="False" Value="{Binding DesktopFontSize, Mode=TwoWay}" AutomationProperties.Name="桌面歌词字号"/>
                                <TextBlock Text="字重" Style="{StaticResource FieldLabel}" Margin="0,13,0,7"/>
                                <ComboBox x:Name="DesktopWeightCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DesktopFontWeight, Mode=TwoWay}" AutomationProperties.Name="桌面歌词字重"/>
                                <Grid Margin="0,16,0,0"><TextBlock Text="副行字号比例（主界面与桌面）" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=SecondaryScaleSlider, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="SecondaryScaleSlider" Minimum="0.4" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" Value="{Binding SecondaryScale, Mode=TwoWay}" AutomationProperties.Name="副行字号比例"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="配色" AutomationProperties.Name="颜色与阴影设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12"><StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="歌词配色" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="雾蓝" Tag="Blue" Click="Palette_Click" Background="#AFCDF5" Foreground="#142337" Padding="15,7" Margin="0,0,7,0" AutomationProperties.Name="应用雾蓝歌词配色"/>
                                <Button Content="月白" Tag="White" Click="Palette_Click" Background="#E5EAF2" Foreground="#293347" Padding="15,7" Margin="0,0,7,0" AutomationProperties.Name="应用月白歌词配色"/>
                                <Button Content="暖砂" Tag="Sand" Click="Palette_Click" Background="#EDCBA1" Foreground="#443323" Padding="15,7" Margin="0,0,7,0" AutomationProperties.Name="应用暖砂歌词配色"/>
                                <Button Content="薄荷" Tag="Mint" Click="Palette_Click" Background="#ADE0CB" Foreground="#203C33" Padding="15,7" AutomationProperties.Name="应用薄荷歌词配色"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="当前歌词" VerticalAlignment="Center"/><Border x:Name="CurrentColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding CurrentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="当前歌词颜色 HEX"/></Grid>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="未播放歌词" VerticalAlignment="Center"/><Border x:Name="InactiveColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding InactiveColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="未播放歌词颜色 HEX"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="翻译歌词" VerticalAlignment="Center"/><Border x:Name="TranslationColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding TranslationColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="翻译歌词颜色 HEX"/></Grid>
                            <TextBlock Text="支持 #RRGGBB；#AARRGGBB 可同时指定透明度。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="逐字填色与描边" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="已唱文字颜色" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SungColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="已唱文字颜色 HEX"/>
                            <TextBlock Text="未唱文字颜色" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/>
                            <TextBox Text="{Binding UnsungColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="未唱文字颜色 HEX"/>
                            <TextBlock Text="已唱描边颜色" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/>
                            <TextBox Text="{Binding SungOutlineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="已唱描边颜色 HEX"/>
                            <Grid Margin="0,12,0,0"><TextBlock Text="已唱描边宽度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SungOutlineWidth, StringFormat={}{0:0.0} px}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider Minimum="0" Maximum="8" TickFrequency="0.1" IsSnapToTickEnabled="False" Value="{Binding SungOutlineWidth, Mode=TwoWay}" AutomationProperties.Name="已唱描边宽度"/>
                            <ComboBox x:Name="SungOutlineStyleCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SungOutlineStyle, Mode=TwoWay}" AutomationProperties.Name="已唱描边样式"/>
                            <TextBlock Text="未唱描边颜色" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/>
                            <TextBox Text="{Binding UnsungOutlineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="未唱描边颜色 HEX"/>
                            <Grid Margin="0,12,0,0"><TextBlock Text="未唱描边宽度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding UnsungOutlineWidth, StringFormat={}{0:0.0} px}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider Minimum="0" Maximum="8" TickFrequency="0.1" IsSnapToTickEnabled="False" Value="{Binding UnsungOutlineWidth, Mode=TwoWay}" AutomationProperties.Name="未唱描边宽度"/>
                            <ComboBox x:Name="UnsungOutlineStyleCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UnsungOutlineStyle, Mode=TwoWay}" AutomationProperties.Name="未唱描边样式"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="桌面歌词悬停背景" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="鼠标移入整个窗口时显示，移开或锁定后只保留歌词文字。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="背景颜色" VerticalAlignment="Center"/><Border x:Name="BackgroundColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="桌面歌词背景颜色 HEX"/></Grid>
                            <Grid Margin="0,16,0,0"><TextBlock Text="悬停背景不透明度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=BackgroundOpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="BackgroundOpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" Value="{Binding BackgroundOpacity, Mode=TwoWay}" AutomationProperties.Name="桌面歌词悬停背景不透明度"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <CheckBox x:Name="ShadowEnabledBox" Content="文字阴影" IsChecked="{Binding ShadowEnabled, Mode=TwoWay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.Name="启用文字阴影"/>
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=ShadowEnabledBox}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="阴影颜色" VerticalAlignment="Center"/><Border x:Name="ShadowColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding ShadowColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="歌词阴影颜色 HEX"/></Grid>
                                <Grid Margin="0,16,0,0"><TextBlock Text="阴影不透明度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ShadowOpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" Value="{Binding ShadowOpacity, Mode=TwoWay}" AutomationProperties.Name="歌词阴影不透明度"/>
                                <Grid Margin="0,12,0,0"><TextBlock Text="模糊半径" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ShadowBlurSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="False" Value="{Binding ShadowBlur, Mode=TwoWay}" AutomationProperties.Name="歌词阴影模糊半径"/>
                                <Grid Margin="0,12,0,0"><TextBlock Text="阴影距离" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ShadowDepthSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="ShadowDepthSlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="False" Value="{Binding ShadowDepth, Mode=TwoWay}" AutomationProperties.Name="歌词阴影距离"/>
                            </StackPanel>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="布局" AutomationProperties.Name="歌词布局设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12"><StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="桌面显示" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="显示方式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="LayoutCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DesktopLayout, Mode=TwoWay}" AutomationProperties.Name="桌面歌词显示方式"/>
                            <TextBlock Text="译文双行会优先显示翻译；没有翻译时显示下一句。" Style="{StaticResource Hint}" Margin="0,9,0,16"/>
                            <TextBlock Text="文字对齐" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="AlignmentCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Alignment, Mode=TwoWay}" AutomationProperties.Name="歌词对齐方式"/>
                            <TextBlock Text="桌面第一行对齐" Style="{StaticResource FieldLabel}" Margin="0,15,0,7"/>
                            <ComboBox x:Name="DesktopMainAlignmentCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DesktopMainAlignment, Mode=TwoWay}" AutomationProperties.Name="桌面歌词第一行对齐"/>
                            <TextBlock Text="桌面第二行对齐" Style="{StaticResource FieldLabel}" Margin="0,15,0,7"/>
                            <ComboBox x:Name="DesktopSecondaryAlignmentCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DesktopSecondaryAlignment, Mode=TwoWay}" AutomationProperties.Name="桌面歌词第二行对齐"/>
                            <Grid Margin="0,19,0,0"><TextBlock Text="桌面窗口宽度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=DesktopWidthSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="DesktopWidthSlider" Minimum="400" Maximum="2200" TickFrequency="20" IsSnapToTickEnabled="False" Value="{Binding DesktopWidth, Mode=TwoWay}" AutomationProperties.Name="桌面歌词窗口宽度"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="始终置于其他窗口上方" IsChecked="{Binding DesktopTopmost, Mode=TwoWay}" AutomationProperties.Name="桌面歌词始终置顶"/>
                            <CheckBox Content="显示歌曲标题与操作提示" IsChecked="{Binding ShowTrackInfo, Mode=TwoWay}" AutomationProperties.Name="桌面歌词显示歌曲信息"/>
                            <TextBlock Text="锁定与鼠标穿透可以在主窗口或桌面歌词右键菜单中切换。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="动画" AutomationProperties.Name="歌词动画设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12"><StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <CheckBox x:Name="AnimationsEnabledBox" Content="启用界面与歌词动画" IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9" AutomationProperties.Name="动画总开关"/>
                            <TextBlock Text="关闭后立即切换画面，适合偏爱安静界面或希望节省资源时使用。" Style="{StaticResource Hint}"/>
                            <CheckBox Content="页面切换淡入" IsChecked="{Binding PageTransitionsEnabled, Mode=TwoWay}" IsEnabled="{Binding IsChecked, ElementName=AnimationsEnabledBox}" Margin="0,17,0,0" AutomationProperties.Name="页面切换动画"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel IsEnabled="{Binding IsChecked, ElementName=AnimationsEnabledBox}">
                            <TextBlock Text="歌词过渡" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="换句效果" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TransitionCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LyricTransition, Mode=TwoWay}" AutomationProperties.Name="歌词换句动画类型"/>
                            <Grid Margin="0,19,0,0"><TextBlock Text="换句动画时长" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=TransitionDurationSlider, StringFormat={}{0:0} ms}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="TransitionDurationSlider" Minimum="100" Maximum="1500" TickFrequency="20" IsSnapToTickEnabled="False" Value="{Binding TransitionDurationMs, Mode=TwoWay}" AutomationProperties.Name="歌词换句动画时长"/>
                            <Grid Margin="0,16,0,0"><TextBlock Text="主歌词滚动时长" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ScrollDurationSlider, StringFormat={}{0:0} ms}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="ScrollDurationSlider" Minimum="100" Maximum="2000" TickFrequency="20" IsSnapToTickEnabled="False" Value="{Binding ScrollDurationMs, Mode=TwoWay}" AutomationProperties.Name="主歌词滚动时长"/>
                            <TextBlock Text="数值越小越利落，数值越大越舒缓。" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                            <Grid Margin="0,17,0,0"><TextBlock Text="当前句聚焦倍率" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=FocusScaleSlider, StringFormat={}{0:0.00} ×}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="FocusScaleSlider" Minimum="1" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="False" Value="{Binding MainFocusScale, Mode=TwoWay}" AutomationProperties.Name="当前歌词聚焦倍率"/>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            <TabItem Header="播放" x:Name="PlaybackTab"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,12">
<Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="专辑展示" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="CoverModeBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="CoverMode_Changed" AutomationProperties.Name="专辑展示模式"/><TextBlock Text="环绕频谱自动跟随封面形状，唱片模式显示在唱片外圈。" Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
<Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="歌词同步" Style="{StaticResource SectionTitle}"/><TextBlock Text="正值让歌词提前，负值让歌词延后。" Style="{StaticResource Hint}"/><TextBlock x:Name="OffsetValue" Text="0 ms" FontSize="20" Margin="0,12,0,12"/><UniformGrid Columns="3"><Button Content="−250 ms" Click="Earlier_Click" Padding="8"/><Button Content="重置" Click="ResetOffset_Click" Padding="8" Margin="6,0"/><Button Content="+250 ms" Click="Later_Click" Padding="8"/></UniformGrid><Button Content="导入歌词文件" Click="Import_Click" Margin="0,14,0,0"/></StackPanel></Border>
<Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="桌面歌词" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="DesktopToggle" Content="显示桌面歌词" Click="Desktop_Click"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem><TabItem Header="来源" x:Name="SourcesTab"><ContentControl x:Name="SourcesHost"/></TabItem></TabControl>
<DockPanel Grid.Row="1" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="恢复外观默认" Click="Reset_Click" Padding="8" FontSize="11"/><TextBlock x:Name="ValidationMessage" Text="修改即时生效并自动保存" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.LiveSetting="Polite"/></DockPanel>
</Grid></UserControl>
