<UserControl x:Class="Embistic.Controls.AnimatedLyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" ClipToBounds="True" Background="Transparent"
             AutomationProperties.Name="同步歌词"
             AutomationProperties.HelpText="点击歌词或聚焦后按回车可跳转；滚动可浏览歌词，播放时五秒后恢复跟随。">
 <UserControl.Resources>
  <Style x:Key="LyricLineButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,11"/>
   <Setter Property="Margin" Value="0,5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#102E4566"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#203A577D"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#799BC6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="FollowButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="#D5E5FF"/>
   <Setter Property="Background" Value="#F01B2A3D"/>
   <Setter Property="BorderBrush" Value="#576F90"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,9"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F02A3F5C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D5E5FF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <ScrollViewer x:Name="Scroller" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Focusable="False">
   <ScrollViewer.OpacityMask>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.09"/>
     <GradientStop Color="#FFFFFFFF" Offset="0.87"/><GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
   </ScrollViewer.OpacityMask>
   <StackPanel x:Name="LineHost">
    <StackPanel.RenderTransform><TranslateTransform x:Name="ScrollTranslation"/></StackPanel.RenderTransform>
    <Border x:Name="TopSpace" IsHitTestVisible="False"/>
    <StackPanel x:Name="RowsPanel" Margin="28,0"/>
    <Border x:Name="BottomSpace" IsHitTestVisible="False"/>
   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="EmptyMessage" Text="播放后自动获取同步歌词" Foreground="#8296B2" FontSize="18"
             TextWrapping="Wrap" TextAlignment="Center" Margin="28" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
  <Button x:Name="FollowButton" Content="↓  回到当前歌词" Style="{StaticResource FollowButtonStyle}"
          Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
          AutomationProperties.AutomationId="ResumeLyricFollow" Click="FollowButton_Click"/>
 </Grid>
</UserControl>
