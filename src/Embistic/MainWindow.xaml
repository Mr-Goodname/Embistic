<Window x:Class="Embistic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:Embistic.Models" xmlns:controls="clr-namespace:Embistic.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Embistic · Emby 音乐" Width="1480" Height="960" MinWidth="1120" MinHeight="720" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown" SourceInitialized="Window_SourceInitialized">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
  <DataTemplate x:Key="AlbumCard" DataType="{x:Type m:Album}">
   <Button Click="Album_Click" Padding="0" Background="Transparent" Width="168" Margin="0,0,16,24" HorizontalContentAlignment="Stretch">
    <StackPanel>
     <Border Width="168" Height="168" Background="{DynamicResource Raised}" CornerRadius="13" ClipToBounds="True">
      <Grid><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE93C;" FontSize="45" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ImageUrl,Converter={StaticResource Artwork}}" Stretch="UniformToFill"/></Grid>
     </Border>
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="1,11,0,4" ToolTip="{Binding Title}"/>
     <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="1,0,0,0" ToolTip="{Binding Artist}"/>
    </StackPanel>
   </Button>
  </DataTemplate>
  <DataTemplate x:Key="TrackRow" DataType="{x:Type m:Track}">
   <Grid Margin="12,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="74"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Raised}" CornerRadius="5" Width="38" Height="38"><Image Source="{Binding ImageUrl,Converter={StaticResource Artwork}}" Stretch="UniformToFill"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
     <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
     <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,12,0"/>
    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <Button Grid.Column="4" Click="AddQueue_Click" Content="&#xE710;" Style="{StaticResource IconButton}" FontSize="14" ToolTip="加入播放队列" Padding="8"/>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="WindowFrame">
  <Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="ContentLayout" Grid.Row="1" Loaded="PlayerChrome_Loaded">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="294"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="12,0,0,33">
     <StackPanel Orientation="Horizontal"><Border Width="35" Height="35" CornerRadius="10" Background="{DynamicResource Accent}"><TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Embistic" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="YOUR MUSIC, AT HOME." Foreground="{DynamicResource Subtle}" FontSize="9" Margin="0,13,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="{DynamicResource AccentSurface}" CornerRadius="10" Padding="12" Margin="0,0,0,15"><StackPanel><TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource AccentInk}" FontSize="12"/><TextBlock Text="{Binding LibraryCountLabel}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
     <RadioButton Style="{StaticResource Nav}" GroupName="Nav" Tag="settings" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="设置"/></StackPanel></RadioButton>
     <TextBlock Text="EMBISTIC  /  WINDOWS" Foreground="{DynamicResource Subtle}" FontSize="9" Margin="17,19,0,0"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="音乐空间" Style="{StaticResource Caption}" Margin="17,0,0,12"/>
     <RadioButton x:Name="HomeNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="home" Checked="Nav_Checked" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="为你推荐"/></StackPanel></RadioButton>
     <RadioButton x:Name="LibraryNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="library" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="媒体库"/></StackPanel></RadioButton>
     <RadioButton x:Name="TracksNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="tracks" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="全部歌曲"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="Nav" Tag="albums" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="专辑"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="Nav" Tag="favorites" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB51;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="我喜欢的"/></StackPanel></RadioButton>
     <TextBlock Text="正在聆听" Style="{StaticResource Caption}" Margin="17,28,0,12"/>
     <RadioButton Style="{StaticResource Nav}" GroupName="Nav" Tag="queue" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="播放队列"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="Nav" Tag="lyrics" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="歌词"/></StackPanel></RadioButton>
     <RadioButton x:Name="DevicesNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="devices" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE995;" FontFamily="Segoe Fluent Icons" Margin="0,0,14,0"/><TextBlock Text="音频与投放"/></StackPanel></RadioButton>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,25,24,16">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid MaxWidth="490" HorizontalAlignment="Left" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Grid}}">
     <TextBox x:Name="SearchBox" Padding="40,12,14,12" TextChanged="Search_TextChanged" ToolTip="按歌曲、歌手、专辑搜索整个 Emby 音乐库"/>
     <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <TextBlock x:Name="SearchHint" Text="搜索歌曲、歌手、专辑" Foreground="{DynamicResource Muted}" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="刷新媒体库" Margin="12,0,0,0"/>
   </Grid>
   <StackPanel x:Name="PageHeading" Grid.Row="1" Margin="0,24,0,22">
    <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Grid x:Name="PageTransitionHost" Grid.Row="2" ClipToBounds="True">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,10,0">
      <Border CornerRadius="18" Padding="26" Margin="0,0,0,25">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#263F5D"/><GradientStop Color="#162537" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="重新发现你的收藏" FontSize="12" Foreground="#A5C3EC"/><TextBlock Text="好音乐，值得专心听。" Foreground="#EDF2FA" FontSize="25" FontWeight="SemiBold" Margin="0,13,0,7"/><TextBlock Text="从熟悉的旋律，到偶然遇见的下一首。" FontSize="12" Foreground="#A5B5C9" Margin="0,0,0,22"/><Button Content="  ▶  开始曲目混播  " HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="ShuffleLibrary_Click"/></StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center"><Ellipse Stroke="#526F92" StrokeThickness="1" Width="120" Height="120"/><Ellipse Stroke="#526F92" StrokeThickness="1" Width="94" Height="94"/><Ellipse Fill="{DynamicResource Accent}" Width="57" Height="57"/><TextBlock Text="♪" FontSize="34" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       </Grid>
      </Border>
      <UniformGrid Columns="3" Margin="0,0,0,29">
       <Button Click="ShuffleLibrary_Click" Padding="16" Margin="0,0,9,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="&#xE8B1;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource AccentInk}"/><TextBlock Text="曲目混播" Margin="0,12,0,4"/><TextBlock Text="随心遇见下一首" Style="{StaticResource Caption}"/></StackPanel></Button>
       <Button Click="RandomAlbum_Click" Padding="16" Margin="4,0,4,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource AccentInk}"/><TextBlock Text="专辑漫游" Margin="0,12,0,4"/><TextBlock Text="完整听一张专辑" Style="{StaticResource Caption}"/></StackPanel></Button>
       <Button Click="FavoriteMix_Click" Padding="16" Margin="9,0,0,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource AccentInk}"/><TextBlock Text="心动收藏" Margin="0,12,0,4"/><TextBlock Text="重温喜欢的声音" Style="{StaticResource Caption}"/></StackPanel></Button>
      </UniformGrid>
      <StackPanel x:Name="HomeModules">
       <StackPanel Tag="favorites"><TextBlock Text="喜爱的专辑" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/><ItemsControl ItemsSource="{Binding FavoriteAlbums}" ItemTemplate="{StaticResource AlbumCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
       <StackPanel Tag="recentAlbums"><TextBlock Text="最近添加" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,18"/><ItemsControl ItemsSource="{Binding RecentAlbums}" ItemTemplate="{StaticResource AlbumCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
       <StackPanel Tag="recentTracks"><TextBlock Text="最近播放的歌曲" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,18"/><ListBox ItemsSource="{Binding RecentPlayedTracks}" ItemTemplate="{StaticResource TrackRow}" MaxHeight="290" MouseDoubleClick="HomeTrack_DoubleClick" Margin="0,0,0,24"/></StackPanel>
       <StackPanel Tag="frequentTracks"><TextBlock Text="最常播放的歌曲" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,18"/><ListBox ItemsSource="{Binding FrequentTracks}" ItemTemplate="{StaticResource TrackRow}" MaxHeight="290" MouseDoubleClick="HomeTrack_DoubleClick" Margin="0,0,0,24"/></StackPanel>
       <StackPanel Tag="playedAlbums"><TextBlock Text="最近播放的专辑" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,18"/><ItemsControl ItemsSource="{Binding RecentPlayedAlbums}" ItemTemplate="{StaticResource AlbumCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
       <StackPanel Tag="frequentAlbums"><TextBlock Text="最常播放的专辑" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,18"/><ItemsControl ItemsSource="{Binding FrequentAlbums}" ItemTemplate="{StaticResource AlbumCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="TracksPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Button Content="▶  播放全部" Style="{StaticResource Primary}" Click="PlayList_Click"/><Button Content="随机播放" Margin="10,0,0,0" Click="ShuffleList_Click"/><Button Content="添加到队列" Margin="10,0,0,0" Click="QueueList_Click"/></StackPanel>
     <Grid Grid.Row="1" Margin="16,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="歌曲 / 歌手" Style="{StaticResource Caption}" Margin="54,0,0,0"/><TextBlock Grid.Column="1" Text="专辑" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="时长" Style="{StaticResource Caption}" Margin="15,0,0,0"/></Grid>
     <ListBox Grid.Row="2" x:Name="TrackList" ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource TrackRow}" MouseDoubleClick="Track_DoubleClick">
      <ListBox.ContextMenu><ContextMenu><MenuItem Header="立即播放" Click="ContextPlay_Click"/><MenuItem Header="下一首播放" Click="ContextNext_Click"/><MenuItem Header="收藏 / 取消收藏" Click="ContextFavorite_Click"/><Separator/><MenuItem Header="下载到此电脑" Click="ContextDownload_Click"/><MenuItem Header="移除本机下载" Click="ContextRemoveDownload_Click"/></ContextMenu></ListBox.ContextMenu>
     </ListBox>
     <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button x:Name="PreviousPageButton" Content="上一页" Click="PreviousPage_Click"/><TextBlock Text="{Binding PagingLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="20,0"/><Button x:Name="NextPageButton" Content="下一页" Click="NextPage_Click"/></StackPanel>
    </Grid>
    <ScrollViewer x:Name="AlbumsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource AlbumCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Button x:Name="MoreAlbumsButton" Content="加载更多专辑" Click="MoreAlbums_Click" HorizontalAlignment="Center" Margin="0,8,0,20"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="LibraryOverviewPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel><ItemsControl ItemsSource="{Binding LibraryShortcuts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="LibraryShortcut_Click" Width="172" Height="126" Margin="0,0,15,15" Background="{DynamicResource Panel}"><StackPanel><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="29" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Name}" Margin="0,18,0,0" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="自定义媒体库与首页" Click="DisplaySettings_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel>
    </ScrollViewer>
    <Grid x:Name="LibraryBrowsePage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,16"><Button x:Name="LibraryBackButton" Content="← 上一级" Click="LibraryBack_Click"/><Button Content="播放此文件夹 / 分类" Click="LibraryPlay_Click" Margin="10,0,0,0"/><Button x:Name="NewPlaylistButton" Content="新建播放列表" Click="CreatePlaylist_Click" Margin="10,0,0,0"/><Button x:Name="NewRadioButton" Content="添加电台" Click="AddRadio_Click" Margin="10,0,0,0"/></WrapPanel>
     <ListBox Grid.Row="1" x:Name="LibraryList" ItemsSource="{Binding LibraryItems}" MouseDoubleClick="LibraryItem_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="6" Background="{DynamicResource Raised}"><Grid><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image Source="{Binding ImageUrl,Converter={StaticResource Artwork}}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Path}"/></StackPanel><TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button Grid.Row="2" x:Name="MoreLibraryButton" Content="加载更多" Click="MoreLibrary_Click" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </Grid>
    <Grid x:Name="QueuePage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Button Content="清空待播队列" Click="ClearQueue_Click"/><Button Content="移除选中" Click="RemoveQueue_Click" Margin="10,0,0,0"/></StackPanel>
     <ListBox Grid.Row="1" x:Name="QueueList" ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource TrackRow}" MouseDoubleClick="Queue_DoubleClick"/>
    </Grid>
    <Grid x:Name="LyricsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,18"><Button Content="桌面歌词" Click="DesktopLyrics_Click" Style="{StaticResource Primary}"/><Button Content="导入 LRC" Click="ImportLyrics_Click" Margin="8,0,0,0"/><Button Content="− 0.25 s" Click="OffsetMinus_Click" Margin="8,0,0,0"/><Button Content="+ 0.25 s" Click="OffsetPlus_Click" Margin="8,0,0,0"/><Button Content="重置" Click="OffsetReset_Click" Margin="8,0,0,0"/><Button x:Name="LyricsAppearanceButton" Content="样式与动效" Click="Appearance_Click" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock Grid.Row="1" Text="{Binding LyricsInfo}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,20"/>
     <TextBlock Grid.Row="2" Text="正在打开沉浸歌词…" Foreground="{DynamicResource Muted}"/>
    </Grid>
    <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="此电脑 · 音频输出" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="切换扬声器、耳机或 USB DAC" Foreground="{DynamicResource Muted}" Margin="0,7,0,20"/><ComboBox x:Name="AudioDeviceBox" ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioDevice_Changed"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="刷新设备" Click="RefreshDevices_Click"/><Button Content="切回此电脑播放" Click="UseLocal_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="libVLC / Windows 音频会话（共享模式）" Foreground="{DynamicResource Subtle}" FontSize="12" Margin="0,18,0,0"/></StackPanel></Border>
     <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="DLNA · 无线投放" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="将 Emby 音乐直接交给同一局域网的音箱播放" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,20"/><Button x:Name="DiscoverButton" Content="搜索局域网设备" Click="Discover_Click" HorizontalAlignment="Left"/><TextBlock Text="{Binding DlnaStatus}" Foreground="{DynamicResource AccentInk}" TextWrapping="Wrap" Margin="0,14,0,12"/><ListBox x:Name="DlnaList" ItemsSource="{Binding DlnaDevices}" DisplayMemberPath="Name" MinHeight="55" MaxHeight="220" Margin="0,0,0,16"/><Button Content="投放当前歌曲" Click="Cast_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><TextBlock Text="投放设备需能访问 Emby；格式支持取决于音箱。投放后支持播放、暂停、进度和音量控制。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsCards">
     <Border Tag="Emby 连接 账号 密码 API 服务器 媒体源" Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="Emby 连接" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="服务器地址" Style="{StaticResource Caption}" Margin="0,20,0,8"/><TextBox x:Name="ServerBox"/><TextBlock Text="登录方式" Style="{StaticResource Caption}" Margin="0,16,0,8"/><ComboBox x:Name="LoginModeBox" SelectedValuePath="Tag" SelectionChanged="LoginMode_Changed"><ComboBoxItem Tag="Password" Content="账号密码"/><ComboBoxItem Tag="ApiKey" Content="API 密钥"/></ComboBox>
      <StackPanel x:Name="PasswordLoginPanel" Visibility="Collapsed"><TextBlock Text="用户名" Style="{StaticResource Caption}" Margin="0,16,0,8"/><TextBox x:Name="UsernameBox"/><TextBlock Text="密码" Style="{StaticResource Caption}" Margin="0,16,0,8"/><PasswordBox x:Name="LoginPasswordBox"/><TextBlock Text="密码不会保存，登录后的访问令牌在本机加密保存。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,16"/><Button x:Name="PasswordLoginButton" Content="登录并连接" Click="PasswordLogin_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel x:Name="ApiLoginPanel"><TextBlock Text="API 密钥（本机加密保存）" Style="{StaticResource Caption}" Margin="0,16,0,8"/><PasswordBox x:Name="ApiKeyBox"/><TextBlock Text="用户" Style="{StaticResource Caption}" Margin="0,16,0,8"/><ComboBox x:Name="UsersBox" ItemsSource="{Binding Users}" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="修改服务器或密钥后先测试连接，再选择用户并保存。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,16"/><WrapPanel><Button Content="测试连接 / 读取用户" Click="TestConnection_Click"/><Button Content="保存并连接" Style="{StaticResource Primary}" Click="SaveConnection_Click" Margin="10,0,0,0"/></WrapPanel></StackPanel>
     </StackPanel></Border>
     <Border Tag="主题 亮色 暗色 系统 强调色 颜色 字体" Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="主题与颜色" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="亮色、暗色或跟随系统；强调色可以自己选，也可以跟随 Windows。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,18"/><Button Content="打开主题设置" Click="Theme_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Tag="界面 首页 导航 媒体库 列表 播放 唱片 启动 音量" Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="界面与播放" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="选择首页和媒体库的内容、顺序、列表密度、启动页面与音量。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,18"/><Button Content="自定义界面与播放" Click="DisplaySettings_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="桌面歌词" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="DesktopEnabledBox" Content="显示桌面歌词" Click="DesktopEnabled_Click" Margin="0,19,0,8"/><CheckBox x:Name="DesktopLockedBox" Content="锁定位置并让鼠标穿透" Click="DesktopLocked_Click"/><TextBlock Text="显示双行同步歌词；解锁后可拖动，右键调整字号与时间偏移。支持 Emby 歌词、网络自动匹配和本地 LRC。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23"/></StackPanel></Border>
     <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,20,0,0"><StackPanel><TextBlock Text="歌词样式与动效" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="自定义字体、配色、阴影和布局，调整歌词滚动与页面切换。修改时实时预览。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,18" LineHeight="23"/><WrapPanel><Button Content="打开样式与动效设置" Click="Appearance_Click" HorizontalAlignment="Left" Style="{StaticResource Primary}"/><Button Content="网络歌词来源" Click="LyricsSources_Click" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
     <Border Tag="频谱 音频 灵敏度 频率 波形 动效" Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,20,0,0"><StackPanel><TextBlock Text="音频频谱" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="调整频谱形态、频段、颜色、灵敏度、平滑和帧率。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,18"/><Button Content="频谱样式设置" Click="SpectrumSettings_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Tag="离线 缓存 下载 存储 备份 恢复" Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,20,0,0"><StackPanel><TextBlock Text="下载、存储与备份" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding DownloadDirectoryLabel}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/><WrapPanel Margin="0,18,0,0"><Button Content="后台播放与缓存" Click="BackgroundSettings_Click"/><Button Content="下载当前歌曲" Click="DownloadCurrent_Click" Margin="8,0,0,0"/><Button Content="已下载音乐" Click="Downloads_Click"/><Button Content="打开下载目录" Click="DownloadFolder_Click" Margin="8,0,0,0"/><Button Content="备份界面设置" Click="BackupSettings_Click" Margin="8,0,0,0"/><Button Content="恢复界面设置" Click="RestoreSettings_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
     <Border Tag="关于 更新 版本 GitHub AI" Background="{DynamicResource Panel}" CornerRadius="14" Padding="24" Margin="0,20,0,0"><StackPanel><TextBlock Text="Embistic 0.4.0" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Windows Emby 音乐客户端。项目代码由 AI 编写。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,16"/><CheckBox x:Name="AutoUpdateBox" Content="启动时检查更新" Click="AutoUpdate_Click"/><WrapPanel><Button Content="检查更新" Click="CheckUpdates_Click"/><Button Content="GitHub" Click="Github_Click" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource AccentInk}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" MinHeight="17" ToolTip="{Binding Status}"/>
  </Grid>
  <Border x:Name="SidebarPlayer" Grid.Column="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
   <Grid Margin="23,32,23,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Grid Margin="0,0,0,22"><TextBlock Text="此刻播放" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="●" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Right"/></Grid>
     <Border Width="248" Height="248" Background="{DynamicResource Raised}" CornerRadius="16" ClipToBounds="True"><Grid><TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons" FontSize="70" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Current.ImageUrl,Converter={StaticResource Artwork}}" Stretch="UniformToFill"/></Grid></Border>
     <TextBlock Text="{Binding CurrentTitle}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" MaxHeight="82" Margin="0,23,0,8"/>
     <TextBlock Text="{Binding CurrentArtist}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxHeight="48"/>
     <DockPanel Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="{Binding FavoriteGlyph}" Style="{StaticResource IconButton}" Click="Favorite_Click" Foreground="{DynamicResource AccentInk}" ToolTip="收藏 / 取消收藏"/><Border Background="{DynamicResource AccentSurface}" CornerRadius="5" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding QualityLabel}" FontSize="10" Foreground="{DynamicResource AccentInk}"/></Border></DockPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,25,0,20">
     <TextBlock Text="歌词" Foreground="{DynamicResource Subtle}" FontSize="11" Margin="0,0,0,17"/>
     <TextBlock x:Name="SidebarCurrentLyric" Text="{Binding CurrentLyric}" Foreground="{DynamicResource SecondaryText}" FontSize="20" FontWeight="Medium" TextWrapping="Wrap" LineHeight="31" MaxHeight="125"/>
     <TextBlock x:Name="SidebarNextLyric" Text="{Binding NextLyric}" Foreground="{DynamicResource Muted}" FontSize="15" TextWrapping="Wrap" LineHeight="26" MaxHeight="81" Margin="0,16,0,0"/>
    </StackPanel>
    <Button Grid.Row="2" Click="DesktopLyrics_Click" Background="{DynamicResource AccentSurface}" Padding="15,13"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentInk}" Margin="0,0,10,0"/><TextBlock Text="{Binding DesktopLyricsLabel}" Foreground="{DynamicResource AccentInk}" FontSize="12"/></StackPanel></Button>
   </Grid>
  </Border>
  <controls:ImmersivePlayerView x:Name="ImmersivePlayer" Grid.ColumnSpan="3" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="10"/>
  <Border x:Name="BottomPlayerBar" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Player}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Panel.ZIndex="20">
   <Grid Margin="25,13,25,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="63"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="PlayerCoverButton" Click="PlayerCover_Click" ToolTip="打开沉浸歌词；右键歌曲菜单" AutomationProperties.Name="正在播放封面" Padding="0" Width="58" Height="58" Background="{DynamicResource Raised}" ContextMenuOpening="PlayerCover_ContextMenuOpening"><Image Source="{Binding Current.ImageUrl,Converter={StaticResource Artwork}}" Stretch="UniformToFill"/><Button.ContextMenu><ContextMenu x:Name="PlayerCoverMenu"/></Button.ContextMenu></Button><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,25,0"><TextBlock Text="{Binding CurrentTitle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentArtist}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="47"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="&#xE8B1;" Style="{StaticResource IconButton}" Click="ShuffleToggle_Click" Foreground="{Binding ShuffleBrush}" ToolTip="随机播放"/>
      <Button Content="&#xE892;" Style="{StaticResource IconButton}" Click="Previous_Click" ToolTip="上一首"/>
      <Button x:Name="PlayPauseButton" AutomationProperties.Name="播放或暂停" Content="{Binding PlayGlyph}" FontFamily="Segoe Fluent Icons" FontSize="20" Width="46" Height="44" Padding="0" Margin="13,0" Style="{StaticResource Primary}" Click="PlayPause_Click" ToolTip="播放 / 暂停（空格）"/>
      <Button Content="&#xE893;" Style="{StaticResource IconButton}" Click="Next_Click" ToolTip="下一首"/>
      <Button Content="{Binding RepeatGlyph}" Style="{StaticResource IconButton}" Click="Repeat_Click" Foreground="{Binding RepeatBrush}" ToolTip="{Binding RepeatLabel}"/>
     </StackPanel>
     <Grid Grid.Row="1" Margin="15,7,15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PositionLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="SeekBar" Minimum="0" Maximum="100" PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up" PreviewKeyUp="Seek_KeyUp" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding DurationLabel}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OutputButton" Content="&#xE995;" Style="{StaticResource IconButton}" Click="Output_Click" ToolTip="音频输出与 DLNA" AutomationProperties.Name="选择播放设备" Padding="8"/><TextBlock Text="{Binding OutputLabel}" Foreground="{DynamicResource AccentInk}" FontSize="11" VerticalAlignment="Center" MaxWidth="205" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputLabel}"/></StackPanel>
     <Grid Margin="18,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="Volume_Changed" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding VolumeLabel}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </StackPanel>
   </Grid>
  </Border>
  <Popup x:Name="OutputPopup" PlacementTarget="{Binding ElementName=OutputButton}" Placement="Top" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
   <Border Width="340" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18">
    <StackPanel><TextBlock Text="播放于" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="此电脑" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="PopupAudioDeviceBox" ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PopupAudioDevice_Changed"/><Button Content="在此电脑播放" Click="PopupUseLocal_Click" Margin="0,10,0,16"/><Grid><TextBlock Text="DLNA 音箱" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/><Button Content="搜索" HorizontalAlignment="Right" Click="PopupDiscover_Click" Padding="12,6"/></Grid><TextBlock Text="{Binding DlnaStatus}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,8"/><ListBox x:Name="PopupDlnaList" ItemsSource="{Binding DlnaDevices}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Click="PopupCastDevice_Click" Background="Transparent" HorizontalContentAlignment="Left" Padding="10,12"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="点击音箱投放当前歌曲" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
   </Border>
  </Popup>
  </Grid>
  <Border x:Name="TitleBar" Grid.RowSpan="2" Height="40" VerticalAlignment="Top" Background="{DynamicResource Sidebar}" Panel.ZIndex="30">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"><TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentInk}" Margin="0,0,9,0"/><TextBlock Text="Embistic" FontSize="12" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="TitleFullscreenButton" Content="&#xE740;" Style="{StaticResource CaptionButton}" Click="TitleFullscreen_Click" ToolTip="全屏（F11）" AutomationProperties.Name="全屏"/>
     <Button x:Name="TitleMinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="TitleMinimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"/>
     <Button x:Name="TitleMaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="TitleMaximize_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原"/>
     <Button x:Name="TitleCloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="TitleClose_Click" ToolTip="关闭" AutomationProperties.Name="关闭"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
