<Window x:Class="Embistic.Views.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Embistic.Controls"
        Title="Embistic · 桌面歌词" Width="860" Height="182" MinWidth="400" MaxWidth="2200" MinHeight="70" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#EFF5FF" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="MainLyricStyle" TargetType="controls:OutlinedLyricsText">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#BFD7FF"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="SecondaryLyricStyle" TargetType="controls:OutlinedLyricsText" BasedOn="{StaticResource MainLyricStyle}">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#C2CDDF"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="DesktopRoot" Background="Transparent">
    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="22,12,22,18">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="锁定并穿透（主窗口可解锁）" Click="Lock_Click"/>
                <Separator/>
                <MenuItem Header="歌词提前 0.25 秒" Click="Advance_Click"/>
                <MenuItem Header="歌词延后 0.25 秒" Click="Delay_Click"/>
                <MenuItem Header="重置时间偏移" Click="ResetOffset_Click"/>
                <Separator/>
                <MenuItem Header="放大字号" Click="Larger_Click"/>
                <MenuItem Header="缩小字号" Click="Smaller_Click"/>
                <Separator/>
                <MenuItem Header="隐藏桌面歌词" Click="Hide_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <DockPanel x:Name="TrackHeader" Margin="0,0,0,9" Visibility="Hidden">
                <TextBlock x:Name="ModeLabel" DockPanel.Dock="Right" FontSize="10" Foreground="#99C4D3E9" Text="拖动移动 · 右键设置"/>
                <TextBlock x:Name="TrackLabel" Text="Embistic · 桌面歌词" FontSize="11" Foreground="#AAC4D3E9" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
            <Grid x:Name="LyricStage" Grid.Row="1" ClipToBounds="False">
                <Canvas x:Name="OutgoingCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel x:Name="OutgoingLayer" Width="{Binding ActualWidth, ElementName=LyricStage}" Opacity="0">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="OutgoingTranslate"/></StackPanel.RenderTransform>
                        <controls:OutlinedLyricsText x:Name="PreviousCurrentLine" Style="{StaticResource MainLyricStyle}"/>
                        <controls:OutlinedLyricsText x:Name="PreviousNextLine" Style="{StaticResource SecondaryLyricStyle}"/>
                    </StackPanel>
                </Canvas>
                <StackPanel x:Name="CurrentLayer">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="CurrentTranslate"/></StackPanel.RenderTransform>
                    <controls:OutlinedLyricsText x:Name="CurrentLine" Text="让音乐流动" Style="{StaticResource MainLyricStyle}"/>
                    <controls:OutlinedLyricsText x:Name="NextLine" Text="播放歌曲后，将自动查找歌词" Style="{StaticResource SecondaryLyricStyle}"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="HoverControls" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" Margin="0,8,0,0">
                <StackPanel.Resources><Style TargetType="Button"><Setter Property="Background" Value="#B0182230"/><Setter Property="Foreground" Value="#EFF5FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3,0"/></Style></StackPanel.Resources>
                <Button Content="−" Click="Smaller_Click" ToolTip="缩小字号" AutomationProperties.Name="缩小桌面歌词字号"/>
                <Button Content="＋" Click="Larger_Click" ToolTip="放大字号" AutomationProperties.Name="放大桌面歌词字号"/>
                <Button Content="提前" Click="Advance_Click" ToolTip="提前 0.25 秒"/>
                <Button Content="延后" Click="Delay_Click" ToolTip="延后 0.25 秒"/>
                <Button Content="锁定" Click="Lock_Click" ToolTip="锁定并鼠标穿透"/>
                <Button Content="隐藏" Click="Hide_Click"/>
            </StackPanel>
        </Grid>
    </Border>
    <Border x:Name="HoverOutline" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
    <Thumb x:Name="WidthGrip" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Hidden"
           Cursor="SizeWE" DragStarted="WidthGrip_DragStarted" DragDelta="WidthGrip_DragDelta" DragCompleted="WidthGrip_DragCompleted"
           AutomationProperties.Name="调整桌面歌词宽度" ToolTip="拖动调整宽度">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" Foreground="#BFCBDDDE" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2"/></Border></ControlTemplate></Thumb.Template>
    </Thumb>
    </Grid>
</Window>
