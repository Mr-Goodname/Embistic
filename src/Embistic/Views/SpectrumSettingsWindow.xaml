<Window x:Class="Embistic.Views.SpectrumSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Embistic.Controls"
 Title="Embistic · 频谱样式" Width="980" Height="850" MinWidth="780" MinHeight="660"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI"
 Loaded="Window_Loaded" Closed="Window_Closed">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentInk}"/>
   <Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="25">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="频谱样式" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="调整形态、响应与配色，让音频有自己的轮廓。" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel Margin="0,0,0,12"><CheckBox x:Name="PreviewEnabledBox" DockPanel.Dock="Right" Content="演示响应" IsChecked="True" Click="PreviewEnabled_Click" Margin="0"/><TextBlock Text="设置预览 · 合成测试信号，不代表当前播放音频" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/></DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <controls:SpectrumView x:Name="PreviewSpectrum" Height="105" IsPlaying="True"/>
     <Grid x:Name="RingPreview" Grid.Column="1" Width="150" Height="150" Margin="18,0,0,0" Visibility="Collapsed">
      <Border Width="100" Height="100" CornerRadius="50" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><TextBlock Text="♫" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Border>
      <controls:SpectrumView x:Name="PreviewRingSpectrum" IsRadial="True" IsPlaying="True"/>
     </Grid>
    </Grid>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GeneralFields" Margin="0,0,12,0"/></ScrollViewer>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StyleFields" Margin="0,0,12,0"/></ScrollViewer>
  </Grid>
  <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><Button Content="恢复默认" Click="Reset_Click" HorizontalAlignment="Left" Padding="10,7" Background="Transparent"/><TextBlock x:Name="ValidationText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,7,12,0" MaxWidth="530" Text="频谱读取本机输出；DLNA 音箱的音频无法在电脑回环捕获。"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="取消" Click="Cancel_Click" MinWidth="80"/><Button x:Name="SaveButton" Content="保存设置" Click="Save_Click" MinWidth="105" Margin="10,0,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"/></StackPanel>
  </Grid>
 </Grid>
</Window>
