<Window x:Class="Embistic.Views.LyricAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Embistic · 歌词外观" Width="1100" Height="820" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsAccent" Color="#ADC9F0"/>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="TextBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="{DynamicResource AccentInk}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="MinHeight" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="SelectedContent" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="11,8,0,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource Text}" Padding="10,7" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <ToggleButton x:Name="DropdownButton" Grid.ColumnSpan="2" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="8"><TextBlock Text="⌄" Foreground="{DynamicResource AccentInk}" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3"/></Border></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Padding="4">
                            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="DropdownButton" Property="Grid.Column" Value="1"/><Setter TargetName="DropdownButton" Property="Grid.ColumnSpan" Value="1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ChoiceBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="ToggleTrack" Background="{DynamicResource Track}" CornerRadius="10" Width="34" Height="20" VerticalAlignment="Center"><Ellipse x:Name="ToggleDot" Width="14" Height="14" Fill="{DynamicResource Thumb}" HorizontalAlignment="Left" Margin="3,0"/></Border>
                    <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="ToggleDot" Property="Fill" Value="{DynamicResource AccentText}"/><Setter TargetName="ToggleDot" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="17,12" Margin="0,0,6,0" CornerRadius="9" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Margin="0,0,0,16"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid x:Name="EditorRoot" Background="{DynamicResource Bg}">
        <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,18">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSurface}" CornerRadius="14" Padding="13,6" VerticalAlignment="Center"><TextBlock Text="EMBISTIC" Foreground="{DynamicResource AccentInk}" FontSize="11" FontWeight="SemiBold"/></Border>
                <StackPanel><TextBlock Text="歌词外观" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="让每一句，都有你喜欢的样子。" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24,20,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged" AutomationProperties.Name="歌词设置分类">
                <TabItem Header="字体" AutomationProperties.Name="字体设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="字体与回退" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="FontFamilyCombo" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="歌词字体和字体回退"/>
                                <TextBlock Text="可以选择本机字体，也可以用英文逗号输入多个字体，按顺序回退。" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="主播放器歌词" Style="{StaticResource SectionTitle}"/>
                                <Grid><TextBlock Text="字号" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=MainSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="MainSizeSlider" Minimum="14" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MainFontSize, Mode=TwoWay}" AutomationProperties.Name="主播放器歌词字号"/>
                                <TextBlock Text="字重" Style="{StaticResource FieldLabel}" Margin="0,13,0,7"/>
                                <ComboBox x:Name="MainWeightCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MainFontWeight, Mode=TwoWay}" AutomationProperties.Name="主播放器歌词字重"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                                <TextBlock Text="桌面歌词" Style="{StaticResource SectionTitle}"/>
                                <Grid><TextBlock Text="字号" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=DesktopSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="DesktopSizeSlider" Minimum="16" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DesktopFontSize, Mode=TwoWay}" AutomationProperties.Name="桌面歌词字号"/>
                                <TextBlock Text="字重" Style="{StaticResource FieldLabel}" Margin="0,13,0,7"/>
                                <ComboBox x:Name="DesktopWeightCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DesktopFontWeight, Mode=TwoWay}" AutomationProperties.Name="桌面歌词字重"/>
                                <Grid Margin="0,16,0,0"><TextBlock Text="副行字号比例（主界面与桌面）" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=SecondaryScaleSlider, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="SecondaryScaleSlider" Minimum="0.4" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SecondaryScale, Mode=TwoWay}" AutomationProperties.Name="副行字号比例"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="颜色与阴影" AutomationProperties.Name="颜色与阴影设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12"><StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="歌词配色" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="雾蓝" Tag="Blue" Click="Palette_Click" Background="#AFCDF5" Foreground="#142337" Padding="15,7" Margin="0,0,7,0" AutomationProperties.Name="应用雾蓝歌词配色"/>
                                <Button Content="月白" Tag="White" Click="Palette_Click" Background="#E5EAF2" Foreground="#293347" Padding="15,7" Margin="0,0,7,0" AutomationProperties.Name="应用月白歌词配色"/>
                                <Button Content="暖砂" Tag="Sand" Click="Palette_Click" Background="#EDCBA1" Foreground="#443323" Padding="15,7" Margin="0,0,7,0" AutomationProperties.Name="应用暖砂歌词配色"/>
                                <Button Content="薄荷" Tag="Mint" Click="Palette_Click" Background="#ADE0CB" Foreground="#203C33" Padding="15,7" AutomationProperties.Name="应用薄荷歌词配色"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="当前歌词" VerticalAlignment="Center"/><Border x:Name="CurrentColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding CurrentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="当前歌词颜色 HEX"/></Grid>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="未播放歌词" VerticalAlignment="Center"/><Border x:Name="InactiveColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding InactiveColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="未播放歌词颜色 HEX"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="翻译歌词" VerticalAlignment="Center"/><Border x:Name="TranslationColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding TranslationColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="翻译歌词颜色 HEX"/></Grid>
                            <TextBlock Text="支持 #RRGGBB；#AARRGGBB 可同时指定透明度。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="桌面背景" Style="{StaticResource SectionTitle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="背景颜色" VerticalAlignment="Center"/><Border x:Name="BackgroundColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="桌面歌词背景颜色 HEX"/></Grid>
                            <Grid Margin="0,16,0,0"><TextBlock Text="背景不透明度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=BackgroundOpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity, Mode=TwoWay}" AutomationProperties.Name="桌面歌词背景不透明度"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <CheckBox x:Name="ShadowEnabledBox" Content="文字阴影" IsChecked="{Binding ShadowEnabled, Mode=TwoWay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.Name="启用文字阴影"/>
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=ShadowEnabledBox}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions><TextBlock Text="阴影颜色" VerticalAlignment="Center"/><Border x:Name="ShadowColorChip" Grid.Column="1" CornerRadius="7" Margin="0,3,8,3"/><TextBox Grid.Column="2" Text="{Binding ShadowColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="歌词阴影颜色 HEX"/></Grid>
                                <Grid Margin="0,16,0,0"><TextBlock Text="阴影不透明度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ShadowOpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding ShadowOpacity, Mode=TwoWay}" AutomationProperties.Name="歌词阴影不透明度"/>
                                <Grid Margin="0,12,0,0"><TextBlock Text="模糊半径" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ShadowBlurSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ShadowBlur, Mode=TwoWay}" AutomationProperties.Name="歌词阴影模糊半径"/>
                                <Grid Margin="0,12,0,0"><TextBlock Text="阴影距离" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ShadowDepthSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                                <Slider x:Name="ShadowDepthSlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ShadowDepth, Mode=TwoWay}" AutomationProperties.Name="歌词阴影距离"/>
                            </StackPanel>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="布局" AutomationProperties.Name="歌词布局设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12"><StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="桌面显示" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="显示方式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="LayoutCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DesktopLayout, Mode=TwoWay}" AutomationProperties.Name="桌面歌词显示方式"/>
                            <TextBlock Text="译文双行会优先显示翻译；没有翻译时显示下一句。" Style="{StaticResource Hint}" Margin="0,9,0,16"/>
                            <TextBlock Text="文字对齐" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="AlignmentCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Alignment, Mode=TwoWay}" AutomationProperties.Name="歌词对齐方式"/>
                            <Grid Margin="0,19,0,0"><TextBlock Text="桌面窗口宽度" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=DesktopWidthSlider, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="DesktopWidthSlider" Minimum="400" Maximum="2200" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding DesktopWidth, Mode=TwoWay}" AutomationProperties.Name="桌面歌词窗口宽度"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="始终置于其他窗口上方" IsChecked="{Binding DesktopTopmost, Mode=TwoWay}" AutomationProperties.Name="桌面歌词始终置顶"/>
                            <CheckBox Content="显示歌曲标题与操作提示" IsChecked="{Binding ShowTrackInfo, Mode=TwoWay}" AutomationProperties.Name="桌面歌词显示歌曲信息"/>
                            <TextBlock Text="锁定与鼠标穿透可以在主窗口或桌面歌词右键菜单中切换。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="动画" AutomationProperties.Name="歌词动画设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12"><StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <CheckBox x:Name="AnimationsEnabledBox" Content="启用界面与歌词动画" IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9" AutomationProperties.Name="动画总开关"/>
                            <TextBlock Text="关闭后立即切换画面，适合偏爱安静界面或希望节省资源时使用。" Style="{StaticResource Hint}"/>
                            <CheckBox Content="页面切换淡入" IsChecked="{Binding PageTransitionsEnabled, Mode=TwoWay}" IsEnabled="{Binding IsChecked, ElementName=AnimationsEnabledBox}" Margin="0,17,0,0" AutomationProperties.Name="页面切换动画"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SectionCard}"><StackPanel IsEnabled="{Binding IsChecked, ElementName=AnimationsEnabledBox}">
                            <TextBlock Text="歌词过渡" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="换句效果" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TransitionCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LyricTransition, Mode=TwoWay}" AutomationProperties.Name="歌词换句动画类型"/>
                            <Grid Margin="0,19,0,0"><TextBlock Text="换句动画时长" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=TransitionDurationSlider, StringFormat={}{0:0} ms}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="TransitionDurationSlider" Minimum="100" Maximum="1500" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding TransitionDurationMs, Mode=TwoWay}" AutomationProperties.Name="歌词换句动画时长"/>
                            <Grid Margin="0,16,0,0"><TextBlock Text="主歌词滚动时长" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=ScrollDurationSlider, StringFormat={}{0:0} ms}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="ScrollDurationSlider" Minimum="100" Maximum="2000" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding ScrollDurationMs, Mode=TwoWay}" AutomationProperties.Name="主歌词滚动时长"/>
                            <TextBlock Text="数值越小越利落，数值越大越舒缓。" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                            <Grid Margin="0,17,0,0"><TextBlock Text="当前句聚焦倍率" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Value, ElementName=FocusScaleSlider, StringFormat={}{0:0.00} ×}" Style="{StaticResource FieldValue}"/></Grid>
                            <Slider x:Name="FocusScaleSlider" Minimum="1" Maximum="1.2" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding MainFocusScale, Mode=TwoWay}" AutomationProperties.Name="当前歌词聚焦倍率"/>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,7,0">
                    <DockPanel Margin="0,11,0,17"><TextBlock Text="实时预览" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="● LIVE" Foreground="{DynamicResource AccentInk}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                    <Border x:Name="MainPreviewSurface" Background="#131E2C" CornerRadius="16" Padding="21,19" BorderBrush="#283B53" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="主播放器" Style="{StaticResource Hint}" Margin="0,0,0,25"/>
                            <TextBlock x:Name="MainPreviousPreview" Text="耳边的旋律，慢慢靠近" FontSize="17" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <TextBlock x:Name="MainCurrentPreview" Text="把此刻，交给一首歌" TextWrapping="Wrap" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,8"/>
                            <TextBlock x:Name="MainTranslationPreview" Text="Let the music fill this moment." TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <TextBlock x:Name="MainNextPreview" Text="沿着节拍，走向下一段风景" FontSize="17" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="桌面悬浮窗" Style="{StaticResource Hint}" Margin="1,21,0,9"/>
                    <Border CornerRadius="15" Padding="10,24" BorderBrush="#35485D" BorderThickness="1">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#31465E" Offset="0"/><GradientStop Color="#18222F" Offset="0.6"/><GradientStop Color="#354248" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Viewbox x:Name="DesktopPreviewViewbox" Stretch="Uniform" StretchDirection="DownOnly">
                            <Border x:Name="DesktopPreviewSurface" Width="860" CornerRadius="18" Padding="22,15,22,18">
                                <StackPanel>
                                    <TextBlock x:Name="DesktopTrackPreview" Text="Embistic · 把此刻交给音乐" Foreground="#BCCCE0" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DesktopCurrentPreview" Text="把此刻，交给一首歌" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="DesktopSecondaryPreview" Text="Let the music fill this moment." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="DesktopPreviewCaption" Text="860 px · 居中 · 译文双行" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,15"/>
                    <Button Content="换句预览" Click="AnimatePreview_Click" Padding="15,10" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource AccentInk}" AutomationProperties.Name="播放歌词动画预览"/>
                    <CheckBox x:Name="LoopPreviewBox" Content="循环演示动画" IsChecked="False" Margin="0,12,0,17" AutomationProperties.Name="循环歌词动画预览"/>
                    <TextBlock Text="预览文字（可编辑）" Style="{StaticResource Hint}" Margin="0,0,0,7"/>
                    <TextBox x:Name="SampleMainBox" Text="把此刻，交给一首歌" MaxLength="100" AutomationProperties.Name="预览歌词文字"/>
                    <TextBox x:Name="SampleTranslationBox" Text="Let the music fill this moment." MaxLength="140" Margin="0,8,0,0" AutomationProperties.Name="预览翻译文字"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="恢复默认" Click="Reset_Click" Background="Transparent" Foreground="{DynamicResource Muted}" Padding="0,11,18,11" AutomationProperties.Name="恢复默认歌词外观"/>
                <TextBlock x:Name="ValidationMessage" Grid.Column="1" Text="更改会实时预览，保存后保留。" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,18,0" AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="2" Content="取消" Click="Cancel_Click" IsCancel="True" Padding="23,11" Margin="0,0,10,0" AutomationProperties.Name="取消歌词外观修改"/>
                <Button x:Name="SaveButton" Grid.Column="3" Content="保存设置" Click="Save_Click" IsDefault="True" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" Padding="23,11" AutomationProperties.Name="保存歌词外观设置"/>
            </Grid>
        </Border>
    </Grid>
</Window>
